# DocQ — Environment Variables
# Copy to .env and fill in the API keys

# Groq API key (get at https://console.groq.com)
# Required for: groq-70b, groq-8b cloud models
GROQ_API_KEY=

# Google AI API key (get at https://aistudio.google.com/apikey)
# Required for: gemini-flash model
GOOGLE_API_KEY=

# ─── API Security (FastAPI) ─────────────────────────────────────────
# Comma-separated API keys. When set, /ask, /ask/stream, /search, /metrics
# require `Authorization: Bearer <key>` (or `X-API-Key`). Leave empty to
# disable auth (local demo). Example: RAG_API_KEYS=key1,key2
RAG_API_KEYS=

# Requests per minute per IP for /ask, /ask/stream, /search (default 60).
# In-memory sliding window; resets on process restart.
RAG_RATE_LIMIT=60
